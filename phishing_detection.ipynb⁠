        "import numpy as np\n",
        "from tensorflow.keras.preprocessing.text import Tokenizer\n",
        "from tensorflow.keras.preprocessing.sequence import pad_sequences\n",
        "\n",
        "# 1. Création et entraînement rapide du Tokenizer (pour qu'il reconnaisse les mots)\n",
        "emails_entrainement = [\n",
        "    \"Your bank account is blocked click here to verify\",\n",
        "    \"Hello friend how are you doing today\"\n",
        "]\n",
        "\n",
        "tokenizer = Tokenizer(num_words=1000)\n",
        "tokenizer.fit_on_texts(emails_entrainement)\n",
        "\n",
        "# 2. L'e-mail que l'on souhaite tester\n",
        "email_test = [\"Your bank account is blocked click here to verify\"]\n",
        "\n",
        "# 3. Tokenisation : Conversion des mots de l'e-mail en séquences de nombres (IDs)\n",
        "sequences = tokenizer.texts_to_sequences(email_test)\n",
        "\n",
        "# 4. Padding : Ajustement de la longueur de l'e-mail (fixée à 6 pour correspondre au modèle)\n",
        "padded_email = pad_sequences(sequences, maxlen=6, padding='post')\n",
        "\n",
        "# 5. Prédiction : Le modèle évalue l'e-mail\n",
        "prediction = model.predict(padded_email)\n",
        "\n",
        "# Affichage du résultat final\n",
        "score = prediction[0][0]\n",
        "print(f\"Score de probabilité (Phishing) : {score:.4f}\")\n",
        "\n",
        "if score > 0.5:\n",
        "    print(\"Résultat : Ce message est suspect (Phishing) 🚨\")\n",
        "else:\n",
        "    print(\"Résultat : Ce message est légitime ✅\")"
